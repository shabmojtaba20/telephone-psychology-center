{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "telephone-psychology-center",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SIGNALING",
        "class_name": "CallSignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "call-signaling-v1",
      "new_sqlite_classes": ["CallSignalingRoom"]
    }
  ]
}